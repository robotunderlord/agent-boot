// "ember" — a warm, low-glare terminal theme for an agent you watch for hours.
//
// This is an EXAMPLE, i.e. somebody's taste. Copy the structure, pick your own colours.
//
// The one choice worth stealing: a near-black warm background rather than pure black, and a single
// bright accent reserved for THE ACTIVE PANE. When the whole screen is one agent working, the only
// thing you need at a glance is where it currently is.
//
// palette: amber 255,175,0 · gold 255,215,0 · green 0,175,0 · red 215,0,0
//          azure 0,135,255 · cyan 0,215,215 · ash 198,198,198 · ground 26,24,20

themes {
    ember {
        text_unselected {
            base 198 198 198
            background 26 24 20
            emphasis_0 255 215 0
            emphasis_1 0 175 0
            emphasis_2 0 135 255
            emphasis_3 215 0 0
        }
        text_selected {
            base 238 238 238
            background 40 36 30
            emphasis_0 255 215 0
            emphasis_1 0 175 0
            emphasis_2 0 135 255
            emphasis_3 215 0 0
        }
        ribbon_selected {
            base 26 24 20
            background 255 215 0
            emphasis_0 215 0 0
            emphasis_1 0 95 0
            emphasis_2 0 135 255
            emphasis_3 120 60 0
        }
        ribbon_unselected {
            base 198 198 198
            background 55 50 42
            emphasis_0 255 175 0
            emphasis_1 238 238 238
            emphasis_2 0 135 255
            emphasis_3 215 0 0
        }
        table_title {
            base 255 215 0
            background 26 24 20
            emphasis_0 255 175 0
            emphasis_1 0 175 0
            emphasis_2 0 135 255
            emphasis_3 215 0 0
        }
        table_cell_selected {
            base 26 24 20
            background 255 175 0
            emphasis_0 215 0 0
            emphasis_1 0 95 0
            emphasis_2 0 135 255
            emphasis_3 120 60 0
        }
        table_cell_unselected {
            base 198 198 198
            background 26 24 20
            emphasis_0 255 215 0
            emphasis_1 0 175 0
            emphasis_2 0 135 255
            emphasis_3 215 0 0
        }
        list_selected {
            base 26 24 20
            background 0 175 0
            emphasis_0 255 215 0
            emphasis_1 238 238 238
            emphasis_2 0 135 255
            emphasis_3 215 0 0
        }
        list_unselected {
            base 198 198 198
            background 26 24 20
            emphasis_0 255 215 0
            emphasis_1 0 175 0
            emphasis_2 0 135 255
            emphasis_3 215 0 0
        }
        // Inactive frames recede; the active frame is the ONE bright thing on screen.
        frame_unselected {
            base 110 100 84
            background 26 24 20
            emphasis_0 255 215 0
            emphasis_1 0 175 0
            emphasis_2 0 135 255
            emphasis_3 215 0 0
        }
        frame_selected {
            base 255 215 0
            background 26 24 20
            emphasis_0 255 175 0
            emphasis_1 0 175 0
            emphasis_2 0 135 255
            emphasis_3 215 0 0
        }
        frame_highlight {
            base 255 175 0
            background 26 24 20
            emphasis_0 255 215 0
            emphasis_1 238 238 238
            emphasis_2 0 135 255
            emphasis_3 215 0 0
        }
        // Green and red are reserved for exit codes and nothing else, so a red on screen always
        // means the same thing.
        exit_code_success {
            base 0 175 0
            background 26 24 20
            emphasis_0 255 215 0
            emphasis_1 238 238 238
            emphasis_2 0 135 255
            emphasis_3 0 215 215
        }
        exit_code_error {
            base 215 0 0
            background 26 24 20
            emphasis_0 255 175 0
            emphasis_1 238 238 238
            emphasis_2 0 135 255
            emphasis_3 255 215 0
        }
        multiplayer_user_colors {
            player_1 255 215 0
            player_2 0 135 255
            player_3 0 175 0
            player_4 215 0 0
            player_5 0 215 215
            player_6 255 175 0
            player_7 175 135 255
            player_8 238 238 238
            player_9 0 135 215
            player_10 175 215 0
        }
    }
}
